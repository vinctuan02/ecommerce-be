# App
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce

# Chỉ bật synchronize ở môi trường dev — production dùng migration.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce

# Swagger
SWAGGER_ROUTE=api-docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# Auth (JWT_ACCESS_SECRET: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
FE_URL=http://localhost:3000

# Tài khoản admin: lúc khởi động chưa có thì tạo, có rồi thì gán role ADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
